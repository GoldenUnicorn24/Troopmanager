#!/usr/bin/env python3
"""Generate registered SVG guides into a chosen directory, never into runtime asset paths."""
import argparse, html, json
from pathlib import Path
from asset_contract import catalog
p=argparse.ArgumentParser(description=__doc__); p.add_argument('directory',type=Path); args=p.parse_args()
for item in catalog():
    w,h=item['width'],item['height']; registration=item['registration']; body=[]
    if 'eyeY' in registration:
        body += ['<ellipse cx="512" cy="550" rx="272" ry="340" fill="none" stroke="#d9b25c" stroke-width="3"/>','<path d="M0 560H1024M0 1050H1024M512 0V1280" stroke="#d9b25c" stroke-width="2"/>']
    elif 'footY' in registration: body += ['<path d="M0 1480H768M384 0V1536" stroke="#d9b25c" stroke-width="3"/>']
    body += [f'<text x="20" y="40" fill="#fff" font-family="sans-serif" font-size="24">GUIDE ONLY: {html.escape(item["path"])}</text>']
    path=args.directory/Path(item['path']).with_suffix('.guide.svg'); path.parent.mkdir(parents=True,exist_ok=True)
    path.write_text(f'<svg xmlns="http://www.w3.org/2000/svg" width="{w}" height="{h}" viewBox="0 0 {w} {h}"><rect width="{w}" height="{h}" fill="#18232c"/>'+''.join(body)+'</svg>\n')
    path.with_suffix('.metadata.json').write_text(json.dumps({'registration':registration,'source':'REQUIRED: actual artist or generator and production date','license':'REQUIRED: actual rights or free license'},indent=2)+'\n')
print(f'{len(catalog())} Führungsmasken erzeugt; keine Laufzeit-Artworks.')
