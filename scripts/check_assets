#!/usr/bin/env python3
"""Validate production images. Missing art is a failure unless explicitly allowed for fallback builds."""
import argparse
import json
from pathlib import Path
from PIL import Image, ImageChops
from asset_contract import ROOT, ASSETS, catalog

def check(root=ASSETS, credits=None):
    credits = (ROOT/'CREDITS.md').read_text() if credits is None else credits
    expected = {item['path']: item for item in catalog()}
    missing, errors, installed, size = [], [], 0, 0
    for name, spec in expected.items():
        path = root/name
        if not path.is_file(): missing.append(name); continue
        installed += 1; size += path.stat().st_size
        try:
            if path.stat().st_size > spec['maxBytes']: raise ValueError('Dateigrößenbudget überschritten')
            with Image.open(path) as im:
                im.load()
                if im.format != 'WEBP': raise ValueError('Datei ist kein WebP')
                if im.size != (spec['width'],spec['height']): raise ValueError(f'falsche Maße: {im.size}')
                alpha=im.convert('RGBA').getchannel('A')
                if spec['alpha'] and (alpha.getextrema()[0] == 255 or (alpha.getbbox() is None and not spec['allowEmpty'])): raise ValueError('sichtbare Ebene mit echtem Alpha erforderlich')
                if not spec['alpha'] and alpha.getextrema()[0] < 255: raise ValueError('Hintergrund muss deckend sein')
                if spec['neutral']:
                    r,g,b=im.convert('RGB').split()
                    mask=alpha.point(lambda p:255 if p else 0)
                    if max(ImageChops.multiply(ImageChops.difference(r,g),mask).getextrema()[1],ImageChops.multiply(ImageChops.difference(g,b),mask).getextrema()[1]) > 3:
                        raise ValueError('einfärbbare Ebene ist nicht neutral grau')
            meta=json.loads(path.with_suffix(path.suffix+'.json').read_text())
            if meta.get('registration') != spec['registration']: raise ValueError('Augen-/Fußlinie oder Mittelachse in Metadaten falsch')
            if not meta.get('source') or not meta.get('license') or any(str(meta[k]).startswith('REQUIRED') for k in ('source','license')): raise ValueError('Herkunft/Lizenz in Metadaten fehlt')
            if name not in credits: raise ValueError('Datei fehlt in CREDITS.md')
        except (OSError,ValueError,KeyError) as exc: errors.append({'path':name,'error':str(exc)})
    for folder in ('portraits','figures','scenes'):
        for path in (root/folder).rglob('*.webp'):
            name=path.relative_to(root).as_posix()
            if name not in expected: errors.append({'path':name,'error':'unbekannter Dateiname'})
    return {'expected':len(expected),'installed':installed,'bytes':size,'missing':missing,'errors':errors}

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--allow-missing',action='store_true',help='Fehlende Kunst für einen ausdrücklich gewählten Fallback-Build zulassen; ungültige Dateien bleiben Fehler.')
    parser.add_argument('--json',action='store_true')
    parser.add_argument('--root',type=Path,default=ASSETS)
    args=parser.parse_args(); report=check(args.root)
    if args.json: print(json.dumps(report,indent=2))
    else:
        for error in report['errors']: print(f"FEHLER {error['path']}: {error['error']}")
        for missing in report['missing']: print(f'FEHLT {missing}')
        print(f"{report['installed']}/{report['expected']} Bilder, {report['bytes']} Byte; {len(report['missing'])} fehlen, {len(report['errors'])} fehlerhaft.")
    return 1 if report['errors'] or (report['missing'] and not args.allow_missing) else 0
if __name__=='__main__': raise SystemExit(main())
